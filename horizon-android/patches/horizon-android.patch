diff --git a/crates/horizon-client/src/embed.rs b/crates/horizon-client/src/embed.rs
new file mode 100644
index 0000000..509ccff
--- /dev/null
+++ b/crates/horizon-client/src/embed.rs
@@ -0,0 +1,99 @@
+//! Running the game inside another program's process, as the Android launcher
+//! does (`horizon-android`): the command line it hands over, the Android app the
+//! window lives in, and touches turned into the pointer the menus read.
+//!
+//! A desktop build never sets any of this, and behaves as before: the arguments
+//! come from the process, the loop is `EventLoop::new()`, touches pass through.
+use std::sync::{Mutex, OnceLock};
+use winit::error::EventLoopError;
+use winit::event::WindowEvent;
+use winit::event_loop::EventLoop;
+
+static ARGS: OnceLock<Vec<String>> = OnceLock::new();
+
+/// The command line to read instead of the process's (which on Android is the
+/// app process's own). Only the first call counts; false when it came too late.
+pub fn set_args(args: Vec<String>) -> bool {
+    ARGS.set(args).is_ok()
+}
+
+/// The game's arguments, without the program name.
+pub fn args() -> Vec<String> {
+    ARGS.get()
+        .cloned()
+        .unwrap_or_else(|| std::env::args().skip(1).collect())
+}
+
+#[cfg(target_os = "android")]
+pub use winit::platform::android::activity::AndroidApp;
+
+#[cfg(target_os = "android")]
+static ANDROID_APP: OnceLock<AndroidApp> = OnceLock::new();
+
+/// The activity the game's window lives in (`android_main`'s argument).
+#[cfg(target_os = "android")]
+pub fn set_android_app(app: AndroidApp) -> bool {
+    ANDROID_APP.set(app).is_ok()
+}
+
+/// The activity set by [`set_android_app`].
+#[cfg(target_os = "android")]
+pub fn android_app() -> Option<&'static AndroidApp> {
+    ANDROID_APP.get()
+}
+
+/// winit's loop: on Android it must know the activity, elsewhere `EventLoop::new()`.
+pub fn event_loop() -> Result<EventLoop<()>, EventLoopError> {
+    #[cfg(target_os = "android")]
+    {
+        use winit::platform::android::EventLoopBuilderExtAndroid;
+        let mut builder = EventLoop::builder();
+        if let Some(app) = ANDROID_APP.get() {
+            builder.with_android_app(app.clone());
+        }
+        builder.build()
+    }
+    #[cfg(not(target_os = "android"))]
+    {
+        EventLoop::new()
+    }
+}
+
+/// The finger that drives the pointer, until it lifts.
+static PRIMARY_FINGER: Mutex<Option<u64>> = Mutex::new(None);
+
+/// On a touch screen with no mouse (Android), the first finger is the mouse:
+/// it moves the pointer and holds the left button, so every screen built for a
+/// mouse takes taps and drags. Other fingers, and every other event, pass as
+/// they are. Elsewhere the event passes unchanged.
+pub fn touch_as_mouse(event: WindowEvent) -> Vec<WindowEvent> {
+    if !cfg!(target_os = "android") {
+        return vec![event];
+    }
+    let WindowEvent::Touch(touch) = event else {
+        return vec![event];
+    };
+    use winit::event::{ElementState, MouseButton, TouchPhase};
+    let mut primary = PRIMARY_FINGER.lock().unwrap_or_else(|e| e.into_inner());
+    let moved = WindowEvent::CursorMoved {
+        device_id: touch.device_id,
+        position: touch.location,
+    };
+    let button = |state| WindowEvent::MouseInput {
+        device_id: touch.device_id,
+        state,
+        button: MouseButton::Left,
+    };
+    match touch.phase {
+        TouchPhase::Started if primary.is_none() => {
+            *primary = Some(touch.id);
+            vec![moved, button(ElementState::Pressed)]
+        }
+        TouchPhase::Moved if *primary == Some(touch.id) => vec![moved],
+        TouchPhase::Ended | TouchPhase::Cancelled if *primary == Some(touch.id) => {
+            *primary = None;
+            vec![moved, button(ElementState::Released)]
+        }
+        _ => Vec::new(),
+    }
+}
