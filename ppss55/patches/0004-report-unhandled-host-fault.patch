+#if KYTY_HOST_ARM64
+// PPSS55: one-shot report of an unresolved host fault, written straight to KYTY_STDOUT_FILE with
+// write(2) (the stdout pipe's drain thread may never run again). Lines are written one at a time so
+// a nested fault while walking the stack still leaves what was already found.
+static void ReportUnhandledFault(int signal_number, const siginfo_t* signal_info, const ucontext_t* context) {
+	static std::atomic<bool> reported {false};
+	if (reported.exchange(true)) {
+		return;
+	}
+	const char* path = std::getenv("KYTY_STDOUT_FILE");
+	const int   fd   = (path != nullptr && path[0] != '\0') ? ::open(path, O_WRONLY | O_APPEND) : STDERR_FILENO;
+	if (fd < 0) {
+		return;
+	}
+	char line[512];
+	auto emit = [&](int n) {
+		if (n > 0) {
+			(void)::write(fd, line, static_cast<size_t>(std::min(n, static_cast<int>(sizeof(line) - 1))));
+		}
+	};
+	auto where = [&](const char* label, uint64_t addr) {
+		Dl_info dl {};
+		if (addr != 0 && ::dladdr(reinterpret_cast<void*>(addr), &dl) != 0 && dl.dli_fname != nullptr) {
+			const char* lib = std::strrchr(dl.dli_fname, '/');
+			emit(std::snprintf(line, sizeof(line), "  %s 0x%016llx %s+0x%llx (%s)\n", label,
+			                   static_cast<unsigned long long>(addr), lib != nullptr ? lib + 1 : dl.dli_fname,
+			                   static_cast<unsigned long long>(addr - reinterpret_cast<uint64_t>(dl.dli_fbase)),
+			                   dl.dli_sname != nullptr ? dl.dli_sname : "?"));
+		} else {
+			emit(std::snprintf(line, sizeof(line), "  %s 0x%016llx (fora de bibliotecas: código JIT/guest?)\n", label,
+			                   static_cast<unsigned long long>(addr)));
+		}
+	};
+	const auto& mc = context->uc_mcontext;
+	emit(std::snprintf(line, sizeof(line),
+	                   "--- Fatal Error ---\nPPSS55: falha nativa não tratada: sinal %d código %d endereço 0x%016llx thread %d\n",
+	                   signal_number, signal_info->si_code,
+	                   static_cast<unsigned long long>(reinterpret_cast<uint64_t>(signal_info->si_addr)), ::gettid()));
+	char thread_name[32] = {};
+	if (::prctl(PR_GET_NAME, thread_name) == 0) {
+		emit(std::snprintf(line, sizeof(line), "  nome da thread: %s\n", thread_name));
+	}
+	where("pc", mc.pc);
+	where("lr", mc.regs[30]);
+	emit(std::snprintf(line, sizeof(line), "  sp 0x%016llx fp 0x%016llx\n", static_cast<unsigned long long>(mc.sp),
+	                   static_cast<unsigned long long>(mc.regs[29])));
+	// Frame-pointer walk, bounded to the faulting thread's stack neighbourhood.
+	uint64_t fp = mc.regs[29];
+	for (int i = 0; i < 24; i++) {
+		if (fp == 0 || (fp & 0xF) != 0 || fp < mc.sp || fp > mc.sp + 8 * 1024 * 1024) {
+			break;
+		}
+		const auto* frame = reinterpret_cast<const uint64_t*>(fp);
+		const uint64_t next = frame[0];
+		const uint64_t ret  = frame[1];
+		char label[16];
+		std::snprintf(label, sizeof(label), "#%02d", i);
+		where(label, ret);
+		if (next <= fp) {
+			break;
+		}
+		fp = next;
+	}
+	if (fd != STDERR_FILENO) {
+		::close(fd);
+	}
+}
+#endif
