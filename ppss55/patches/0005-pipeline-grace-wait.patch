+// PPSS55: KYTY_PIPELINE_GRACE_MS (0-50, default 0 = skip at once). With async shaders, a draw
+// whose pipeline is still compiling is dropped for the frame; on Adreno a pipeline usually takes a
+// few ms, so waiting that long lets most such draws appear in their first frame instead of
+// flickering in later. Waits are capped by a budget of 4x the grace per 100 ms, so a burst of new
+// pipelines (a scene load) still falls back to skipping instead of freezing the GPU thread.
+static void WaitPipelineGrace(const ShaderWorkerPool::Job& job) {
+	static const int64_t grace_us = [] {
+		const char* env = std::getenv("KYTY_PIPELINE_GRACE_MS");
+		const long  ms  = env != nullptr ? std::strtol(env, nullptr, 10) : 0;
+		return static_cast<int64_t>(std::clamp(ms, 0L, 50L)) * 1000;
+	}();
+	if (grace_us == 0) {
+		return;
+	}
+	static thread_local int64_t window_start_us = 0;
+	static thread_local int64_t spent_us        = 0;
+	const auto now_us = [] {
+		return std::chrono::duration_cast<std::chrono::microseconds>(
+		           std::chrono::steady_clock::now().time_since_epoch())
+		    .count();
+	};
+	const int64_t start = now_us();
+	if (start - window_start_us > 100000) {
+		window_start_us = start;
+		spent_us        = 0;
+	}
+	const int64_t allowed = std::min(grace_us, 4 * grace_us - spent_us);
+	while (allowed > 0 && !job.Done() && now_us() - start < allowed) {
+		std::this_thread::sleep_for(std::chrono::microseconds(200));
+	}
+	spent_us += now_us() - start;
+}
