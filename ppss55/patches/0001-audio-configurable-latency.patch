-constexpr uint64_t AUDIO_OUT_TARGET_LATENCY_US = 40000;
+constexpr uint64_t AUDIO_OUT_DEFAULT_TARGET_LATENCY_US = 40000;
+
+// PPSS55: queue depth kept ahead of the device. 40 ms is fine on desktop, but on phones a guest hitch
+// (shader compile, FEX translation, a slow frame) longer than that drains the SDL queue and the sound
+// crackles. KYTY_AUDIO_LATENCY_MS (10-500) trades latency for stability; unset keeps the default.
+static uint64_t AudioOutTargetLatencyUs() {
+	static const uint64_t value = [] {
+		if (const char* env = std::getenv("KYTY_AUDIO_LATENCY_MS"); env != nullptr) {
+			const long ms = std::strtol(env, nullptr, 10);
+			if (ms >= 10 && ms <= 500) {
+				LOGF("AudioOut: target latency %ld ms (KYTY_AUDIO_LATENCY_MS)\n", ms);
+				return static_cast<uint64_t>(ms) * 1000u;
+			}
+		}
+		return AUDIO_OUT_DEFAULT_TARGET_LATENCY_US;
+	}();
+	return value;
+}
 
 constexpr int      AUDIO_IN_SILENT_STATE_DEVICE_NONE = 0x1;
 constexpr uint32_t AUDIO_IN_GRAIN_MAX_ASYNC          = 384;
